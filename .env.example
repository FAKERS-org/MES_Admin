# Base URL of the MES_Api FastAPI server.
# Used only on the server (Node), never sent to the browser, so CORS on the
# API does not need to allow this app.
API_URL=http://127.0.0.1:8000

# Session cookie settings (optional overrides)
# ACCESS_TOKEN_EXPIRE_MINUTES must match the API setting (default 30).
# SESSION_MAX_AGE=1800
